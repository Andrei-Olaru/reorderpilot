REORDERPILOT_DATA_DIR="./data"
AS_OF_DATE="2011-11-01"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
LLM_API_KEY="your_groq_api_key_here"
# Optional failover pool (comma-separated). If set, it is used instead of LLM_API_KEY.
# GROQ_API_KEYS="key1,key2"
# Cache identical LLM requests in data/llm_cache.db (the app; evals use their own cache).
LLM_RESPONSE_CACHE="false"
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
