# Secrets
.env

# Data (raw, processed, memory.db, LLM cache) lives in DATA_DIR, never in git
/data/

# Model artifacts: keep metrics.json (quoted by README), ignore binaries
artifacts/*
!artifacts/.gitkeep
!artifacts/metrics.json

# Python / tooling caches
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.cache/
eval/.cache/

# Raw dataset files if downloaded outside DATA_DIR (must not be redistributed)
*.xlsx
# Private study material: never tracked
docs/*_MASTERY*
docs/*.html

# Any .env variant except the template
.env.*
!.env.example
